class Employee:

    def __init__(self, employee_id="Not Assigned", name="Unknown",
                 age=0, salary=0):

        self.__employee_id = employee_id
        self.name = name
        self.age = age
        self.__salary = salary

        print(f"Employee object for {self.name} created successfully!")

    def __del__(self):
        print(f"Employee object for {self.name} deleted from memory.")

    def get_employee_id(self):
        return self.__employee_id

    def set_employee_id(self, new_id):
        self.__employee_id = new_id

    def get_salary(self):
        return self.__salary

    def set_salary(self, new_salary):
        if new_salary >= 0:
            self.__salary = new_salary
        else:
            print("Salary cannot be negative!")

    def display(self):
        print("Employee Details")
        print("Name :", self.name)
        print("Age :", self.age)
        print("Employee ID :", self.__employee_id)
        print("Salary :", self.__salary)


class Manager(Employee):

    def __init__(self, employee_id, name, age, salary, department):

        super().__init__(employee_id, name, age, salary)

        self.department = department

        print(f"Manager {self.name} added successfully!")

    def display(self):
        print("\n===== Manager Details =====")
        print("Name :", self.name)
        print("Age :", self.age)
        print("Employee ID :", self.get_employee_id())
        print("Salary :", self.get_salary())
        print("Department :", self.department)


class Developer(Employee):

    def __init__(self, employee_id, name, age, salary,
                 programming_language):

        super().__init__(employee_id, name, age, salary)

        self.programming_language = programming_language

        print(f"Developer {self.name} added successfully!")

    def display(self):
        print("Developer Details")
        print("Name :", self.name)
        print("Age :", self.age)
        print("Employee ID :", self.get_employee_id())
        print("Salary :", self.get_salary())
        print("Programming Language :",
              self.programming_language)


employee_records = []


def create_employee():

    print("\n----- Create Employee -----")

    emp_id = input("Enter Employee ID : ")
    emp_name = input("Enter Name : ")
    emp_age = int(input("Enter Age : "))
    emp_salary = float(input("Enter Salary : "))

    employee = Employee(emp_id, emp_name,
                        emp_age, emp_salary)

    employee_records.append(employee)

    print("Employee added successfully!")


def create_manager():

    print("Create Manager")

    emp_id = input("Enter Employee ID : ")
    emp_name = input("Enter Name : ")
    emp_age = int(input("Enter Age : "))
    emp_salary = float(input("Enter Salary : "))
    department = input("Enter Department : ")

    manager = Manager(emp_id, emp_name,
                      emp_age, emp_salary,
                      department)

    employee_records.append(manager)

    print("Manager added successfully!")


def create_developer():

    print("Create Developer")

    emp_id = input("Enter Employee ID : ")
    emp_name = input("Enter Name : ")
    emp_age = int(input("Enter Age : "))
    emp_salary = float(input("Enter Salary : "))
    language = input("Enter Programming Language : ")

    developer = Developer(emp_id, emp_name,
                          emp_age, emp_salary,
                          language)

    employee_records.append(developer)

    print("Developer added successfully!")


def show_all_details():

    print("All Employee Details")

    if len(employee_records) == 0:
        print("No employee records found!")

    else:
        for employee in employee_records:
            employee.display()


def update_salary():

    emp_id = input("Enter Employee ID to update salary : ")

    found = False

    for employee in employee_records:

        if employee.get_employee_id() == emp_id:

            new_salary = float(input("Enter New Salary : "))
            employee.set_salary(new_salary)

            print("Salary updated successfully!")
            found = True
            break

    if not found:
        print("Employee not found!")


def remove_employee():

    emp_id = input("Enter Employee ID to remove : ")

    found = False

    for employee in employee_records:

        if employee.get_employee_id() == emp_id:

            employee_records.remove(employee)

            print("Employee removed successfully!")
            found = True
            break

    if not found:
        print("Employee not found!")


def check_subclass():

    print("Subclass Checking")

    print("Is Manager subclass of Employee ?",
          issubclass(Manager, Employee))

    print("Is Developer subclass of Employee ?",
          issubclass(Developer, Employee))


while True:

    
    print(" EMPLOYEE MANAGEMENT SYSTEM ")
    

    print("1. Create Employee")
    print("2. Create Manager")
    print("3. Create Developer")
    print("4. Show All Details")
    print("5. Update Salary")
    print("6. Remove Employee")
    print("7. Check Subclass")
    print("8. Exit")

    choice = input("Enter your choice : ")

    if choice == "1":
        create_employee()

    elif choice == "2":
        create_manager()

    elif choice == "3":
        create_developer()

    elif choice == "4":
        show_all_details()

    elif choice == "5":
        update_salary()

    elif choice == "6":
        remove_employee()

    elif choice == "7":
        check_subclass()

